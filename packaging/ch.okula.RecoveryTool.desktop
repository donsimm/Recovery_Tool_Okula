[Desktop Entry]
Type=Application
Name=Okula Recovery Tool
Comment=Backups und Disk-Images von Maschinen im LAN
Exec=python3 -m okula_recovery
Path=/opt/okula-recovery
Icon=okula-recovery
Terminal=false
Categories=System;
# Dateiname = Programm-ID (Wayland), StartupWMClass = WM_CLASS (X11): so zeigen Alt+Tab und Dock Name und Logo
StartupWMClass=ch.okula.RecoveryTool
