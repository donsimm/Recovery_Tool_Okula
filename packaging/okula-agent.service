# Agent auf dem USB-Stick: meldet die Zielmaschine beim Recovery-Tool an.
# Liegt im Squashfs-Image okula-agent.squashfs des Agent-Sticks und ist dort aktiviert.
[Unit]
Description=Okula Recovery Agent (Anmeldung beim Recovery-Tool)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/okula-agent.conf
ExecStart=/bin/sh /opt/okula-recovery/start-agent.sh
Restart=always
RestartSec=3
# Ausführliches Protokoll nur ins Journal; wichtige Meldungen schreibt der Agent
# selbst sauber (ohne Zeitstempel/Präfix) auf tty1, siehe --console
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
