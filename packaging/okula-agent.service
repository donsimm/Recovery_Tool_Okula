# Agent auf dem USB-Stick: meldet die Zielmaschine beim Recovery-Tool an.
# Wird vom live-config-Hook des Agent-Sticks installiert und gestartet.
[Unit]
Description=Okula Recovery Agent (Anmeldung beim Recovery-Tool)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/okula-recovery
EnvironmentFile=-/etc/okula-agent.conf
ExecStart=/usr/bin/python3 -m okula_recovery.agent $AGENT_ARGS
Restart=always
RestartSec=3
# Statusmeldungen auch auf der Konsole der Zielmaschine anzeigen
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
