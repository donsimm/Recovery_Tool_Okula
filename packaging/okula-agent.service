# Agent auf dem USB-Stick: meldet die Zielmaschine beim Recovery-Tool an.
# Liegt im Squashfs-Image okula-agent.squashfs des Agent-Sticks und ist dort aktiviert.
[Unit]
Description=Okula Recovery Agent (Anmeldung beim Recovery-Tool)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/okula-agent.conf
ExecStart=/bin/sh /opt/okula-recovery/start-agent.sh
Restart=always
RestartSec=3
# Statusmeldungen auch auf der Konsole der Zielmaschine anzeigen
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
