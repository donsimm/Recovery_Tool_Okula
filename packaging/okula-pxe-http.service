[Unit]
Description=Okula Recovery Tool – Netzwerkstart, Dateien nur für freigeschaltete Geräte (HTTP)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/okula-recovery
ExecStart=/usr/bin/python3 -m okula_recovery.pxe serve
Restart=on-failure
RestartSec=5
# liest die ARP-Tabelle; schreibt nur die Startarten unter /var/lib/okula-recovery/pxe
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/
ReadWritePaths=/var/lib/okula-recovery/pxe

[Install]
WantedBy=multi-user.target
